# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Srodowisko i buildy
.env
.conda/
build/
**/build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.so
*.o
*.a

# Logi i modele
*.log
*.pth
*.pt
*.ckpt

# Dane scen pobierane lokalnie
scenes_ve_metadata_locations/

# outputs/ — wszystko, co generuja skrypty: dataset ech (~19 GB), zalatane siatki,
# posrednie spektrogramy. Domyslnie ignorowane; wersjonujemy tylko male pliki
# dowodowe (wyniki pomiarow, na ktorych opieraja sie liczby w docs/).
#
# Dwie rzeczy o skladni, latwe do zepsucia przy edycji:
#  - git nie wchodzi do zignorowanego katalogu, stad "!outputs/**/" — bez tego
#    zadna pozniejsza negacja nie zadziala;
#  - negacje musza stac PO "*.log" wyzej, bo o losie pliku decyduje OSTATNI
#    pasujacy wzorzec.
outputs/**
!outputs/**/
!outputs/diagnose_rlr_noise_out/*.json
!outputs/diagnose_rlr_noise_out/*.png
!outputs/probe_census/*.csv
!outputs/measurements/*/*.csv
!outputs/measurements/*/*.json
!outputs/measurements/dataset_check/*.log
!outputs/measurements/sabine/summary.txt
# Faza uczenia: podzial lokalizacji, raporty weryfikacji dataloadera, benchmark
# i konfiguracja macierzy eksperymentow. To pliki, na ktorych opieraja sie liczby
# w docs/RAPORT_SESJI_2026-08-05.md — lacznie ~65 KB.
!outputs/ml/splits/*.json
!outputs/ml/verify_loader/*/*.json
!outputs/ml/bench/*.json
!outputs/ml/experiments.json
# Sesja 2026-08-10: rozstrzygniecie geometrii main-vs-patched (Blok 0), kontrola
# niedeterminizmu decydujaca o --fast-bilinear (Blok 1.1) i kontrola permutacyjna
# echa (Blok 1.2). Bez tych plikow decyzji z raportu nie da sie zweryfikowac.
!outputs/ml/geometry_check/*.json
!outputs/ml/determinism/*.json
!outputs/ml/echo_ablation/*.json
# Sesja 2026-08-11: budzet dysku, kontrola maski scislej, eksport liczb do pracy.
!outputs/ml/disk_budget.json
!outputs/ml/thesis_numbers.json
!outputs/ml/mask_check/*.json
# Sesja 2026-08-16: rysunki do pracy (~390 KB). Wchodza do repo, bo powstaja z
# zapisanych plikow dowodowych i musza byc wersjonowane RAZEM z liczbami, ktore
# przedstawiaja -- inaczej rysunek w tekscie i liczba w tabeli moga sie rozjechac
# bez sladu. Odtwarzalne: `ml/analysis/figures.py`, zero GPU.
!outputs/ml/figures/*.png
# Sesja 2026-08-17: sondowanie zamrozonych reprezentacji. Wchodza `status.json`
# (niosa SUMY KONTROLNE potwierdzajace, ze enkoder byl zamrozony -- bez nich
# wynik sondy jest nie do zweryfikowania), `best.json`, `cka.json` i regula
# zapisana przed pomiarem. `metrics.jsonl` zostaje poza gitem.
!outputs/ml/probing/*.json
!outputs/ml/probing/*.md
!outputs/ml/probing/*/status.json
!outputs/ml/probing/*/best.json
# Zdjecia wag z kontroli niedeterminizmu: ~15 GB, kasowane automatycznie po
# zapisaniu liczb do JSON-a. Wymienione jawnie na wypadek przerwanego przebiegu.
outputs/ml/determinism/_snapshots/**
# Przebiegi treningowe zostaja poza gitem. Zmierzone 2026-08-10: pelny model to
# 316 918 781 parametrow, czyli 1.18 GB samych wag, ale `checkpoint.pt` zawiera
# TAKZE dwa momenty Adama -> 3.54 GB. Razem z `best_*.pth` daje to 4.72 GB na
# przebieg pelnego modelu i 0.13 GB na przebieg echo2depth; cala macierz
# (66 przebiegow) to 161 GB, albo 40 GB po skasowaniu checkpointow wznowieniowych.
outputs/ml/runs/**
outputs/ml/pretext/**
outputs/ml/pretext_transfer/**
outputs/ml/eval/**/*.npz
# Wyniki ewaluacji (male JSON-y) zostaja w gicie -- to na nich stoja tabele pracy.
!outputs/ml/eval/**/*.json

# Zagniezdzone repozytoria wendorowanych zaleznosci (habitat-sim,
# beyond-image-to-depth). Git NIE zaglada do katalogu ".git", wiec sam z siebie
# jest bezpieczny — ale PRZEMIANOWANY (np. ".git.disabled" przy dodawaniu
# zaleznosci plikami zamiast submodulem) traci te ochrone i da sie go
# przypadkiem zacommitowac razem z packiem. Zdarzylo sie raz.
**/.git.disabled/
**/.git.bak/
