# Dane scen pobierane lokalnie
scenes_ve_metadata_locations/

# outputs/ — wszystko, co generuja skrypty: dataset ech (~19 GB), zalatane siatki,
# posrednie spektrogramy. Domyslnie ignorowane; wersjonujemy tylko male pliki
# dowodowe (wyniki pomiarow, na ktorych opieraja sie liczby w docs/).
#
# Dwie rzeczy o skladni, latwe do zepsucia przy edycji:
#  - git nie wchodzi do zignorowanego katalogu, stad "!outputs/**/" — bez tego
#    zadna pozniejsza negacja nie zadziala;
#  - negacje musza stac PO "*.log" wyzej, bo o losie pliku decyduje OSTATNI
#    pasujacy wzorzec.
outputs/**
!outputs/**/
!outputs/diagnose_rlr_noise_out/*.json
!outputs/diagnose_rlr_noise_out/*.png
!outputs/probe_census/*.csv
!outputs/measurements/*/*.csv
!outputs/measurements/*/*.json
!outputs/measurements/dataset_check/*.log
!outputs/measurements/sabine/summary.txt
